[
  { "expr": "1", "expect": 1 },
  { "expr": "1.5", "expect": 1.5 },
  { "expr": "'hello'", "expect": "hello" },
  { "expr": "\"hello\"", "expect": "hello" },
  { "expr": "true", "expect": true },
  { "expr": "false", "expect": false },
  { "expr": "null", "expect": null },

  { "expr": "1 + 2 * 3", "expect": 7 },
  { "expr": "(1 + 2) * 3", "expect": 9 },
  { "expr": "10 - 4 - 3", "expect": 3 },
  { "expr": "2 * 3 + 4 * 5", "expect": 26 },
  { "expr": "-5 + 2", "expect": -3 },
  { "expr": "7 % 3", "expect": 1 },

  { "expr": "10 / 4", "expect": 2.5 },
  { "expr": "1 / 0", "expect": null },
  { "expr": "1 % 0", "expect": null },

  { "expr": "amount * qty", "record": { "amount": 10.5, "qty": 3 }, "expect": 31.5 },
  { "expr": "record.amount * record.qty", "record": { "amount": 2, "qty": 4 }, "expect": 8 },
  { "expr": "missing", "record": { "a": 1 }, "expect": null },
  { "expr": "missing + 1", "record": {}, "expect": null },
  { "expr": "constructor", "record": {}, "expect": null },
  { "expr": "toString", "record": { "a": 1 }, "expect": null },
  { "expr": "record.hasOwnProperty", "record": {}, "expect": null },
  { "expr": "constructor == null", "record": {}, "expect": true },
  { "expr": "len(toString)", "record": {}, "expect": 0 },
  { "expr": "amount * qty", "record": { "amount": null, "qty": 3 }, "expect": null },

  { "expr": "1 == 1", "expect": true },
  { "expr": "1 != 2", "expect": true },
  { "expr": "'a' == 'a'", "expect": true },
  { "expr": "'1' == 1", "expect": false },
  { "expr": "null == null", "expect": true },
  { "expr": "category == ''", "record": { "category": "" }, "expect": true },
  { "expr": "category == ''", "record": { "category": "food" }, "expect": false },
  { "expr": "category == null", "record": {}, "expect": true },

  { "expr": "3 > 2", "expect": true },
  { "expr": "3 >= 3", "expect": true },
  { "expr": "2 < 1", "expect": false },
  { "expr": "'apple' < 'banana'", "expect": true },

  { "expr": "true && false", "expect": false },
  { "expr": "true || false", "expect": true },
  { "expr": "!true", "expect": false },
  { "expr": "!''", "expect": true },
  { "expr": "!'x'", "expect": false },
  { "expr": "!0", "expect": true },
  { "expr": "!null", "expect": true },
  { "expr": "paid && amount > 100", "record": { "paid": true, "amount": 150 }, "expect": true },
  { "expr": "paid && amount > 100", "record": { "paid": false, "amount": 150 }, "expect": false },

  { "expr": "false && (1 / 0)", "expect": false },
  { "expr": "true || nonsense_field", "expect": true },

  { "expr": "'a' + 'b'", "expect": "ab" },
  { "expr": "'n=' + 5", "expect": "n=5" },
  { "expr": "5 + '!'", "expect": "5!" },
  { "expr": "first + ' ' + last", "record": { "first": "Ada", "last": "L" }, "expect": "Ada L" },

  { "expr": "len('hello')", "expect": 5 },
  { "expr": "len(note)", "record": { "note": "abc" }, "expect": 3 },
  { "expr": "len(missing)", "record": {}, "expect": 0 },
  { "expr": "lower('ABC')", "expect": "abc" },
  { "expr": "upper('abc')", "expect": "ABC" },
  { "expr": "abs(-4)", "expect": 4 },
  { "expr": "round(2.567)", "expect": 3 },
  { "expr": "round(2.567, 2)", "expect": 2.57 },
  { "expr": "round(2.5)", "expect": 3 },
  { "expr": "round(-2.5)", "expect": -3 },
  { "expr": "round(-0.5)", "expect": -1 },
  { "expr": "round(-1.25, 1)", "expect": -1.3 },
  { "expr": "round(2.567, 1.9)", "expect": 2.6 },
  { "expr": "round(2.567, -1)", "expect": 3 },
  { "expr": "coalesce(null, 'fallback')", "expect": "fallback" },
  { "expr": "coalesce(a, b, 'z')", "record": { "a": null, "b": "y" }, "expect": "y" },
  { "expr": "coalesce(null, null)", "expect": null },
  { "expr": "concat('a', 1, true)", "expect": "a1true" },

  { "expr": "today()", "now": "2026-08-02T04:00:00Z", "expect": "2026-08-02" },
  { "expr": "now()", "now": "2026-08-02T04:00:00Z", "expect": "2026-08-02T04:00:00Z" },

  { "expr": "", "error": true },
  { "expr": "1 +", "error": true },
  { "expr": "(1", "error": true },
  { "expr": "1)", "error": true },
  { "expr": "a = 1", "error": true },
  { "expr": "frobnicate(1)", "error": true },
  { "expr": "1 1", "error": true },
  { "expr": "'unterminated", "error": true },
  { "expr": "-'text'", "error": true },
  { "expr": "true + 1", "error": true },
  { "expr": "len(5)", "error": true },
  { "expr": "1 @ 2", "error": true }
]
